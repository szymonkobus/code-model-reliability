# environments and caches
.venv/
venv*/
__pycache__/
*.pyc
.cache/
.pytest_cache/
*.egg-info/
uv.lock
# fit outputs and logs produced by running the engine locally (the published fit lives under data/results/)
fits/
*.log
# figures regenerate from the published tables (the figure scripts write here)
figures/*.png
figures/*.svg
# keys come from the environment, never from a file here
*.env
*.key
*.pem
*-api-key*
*.token
